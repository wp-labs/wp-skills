{
  "name": "wpl-rule-check",
  "version": "5.1.0",
  "display_name": "WPL 规则编写与验证",
  "description": "根据用户提供的原始日志和可选原始文档生成、审计或修复 WPL/OML；缺少字段说明时推断并标注假设，再验证 SDM 行为信封和 raw 双路输出",
  "author": "wp-labs",
  "license": "MIT",
  "platforms": [
    "codex",
    "claude-code"
  ],
  "categories": [
    "log-parsing",
    "wpl",
    "oml",
    "rule-authoring"
  ],
  "triggers": {
    "keywords": [
      "WPL",
      "OML",
      "parse.wpl",
      "rule.wpl",
      "wpl-check",
      "WarpParse",
      "$wpl-rule-check",
      "WarpParse 解析规则",
      "WarpParse 富化模型"
    ],
    "patterns": [
      "怎么写.*WPL",
      "WPL.*语法",
      "WarpParse.*解析规则",
      "WarpParse.*富化模型",
      "OML.*怎么写",
      "修改.*parse\\.wpl",
      "修改.*rule\\.wpl",
      "wpl-check.*验证"
    ]
  },
  "dependencies": {
    "optional": [
      {
        "name": "wpadm",
        "description": "工程配置与 WPL/OML 模型静态检查，随 WarpParse 提供"
      },
      {
        "name": "wparse",
        "description": "WarpParse batch 解析运行时，随 WarpParse 提供"
      }
    ]
  },
  "resources": {
    "docs": "https://docs.warpparse.ai",
    "editor": "https://editor.warpparse.ai",
    "github": "https://github.com/wp-labs"
  },
  "files": {
    "skill": "SKILL.md",
    "agents": {
      "openai": "agents/openai.yaml"
    },
    "references": [
      "references/new-standard.md",
      "references/migration-sdm-event-behavior.md",
      "references/workflow.md",
      "references/wpl-oml-syntax.md",
      "references/sdm2-log-standard-catalog.md",
      "references/deterministic-generation.md",
      "references/schemas/sdm-event-behavior-kafka.schema.json",
      "references/contracts/event_operation_dictionary.json",
      "references/contracts/031_sdm_event_behavior.sql",
      "references/contracts/032_routine_load_sdm_event_behavior.sql",
      "scripts/parse_wpl.py",
      "scripts/check_pipeline.py",
      "tests/test_pipeline.py"
    ]
  }
}
