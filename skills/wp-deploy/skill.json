{
  "name": "wp-deploy",
  "version": "1.0.0",
  "display_name": "WarpParse 部署配置指导",
  "description": "指导通过 wproj 生成 WarpParse 配置基线，并配置 source/sink/connectors/topology、wpgen、wp-monitor 与联调部署",
  "author": "wp-labs",
  "license": "MIT",
  "platforms": [
    "codex",
    "claude-code"
  ],
  "categories": [
    "deployment",
    "devops",
    "connectors",
    "observability"
  ],
  "triggers": {
    "keywords": [
      "wp-deploy",
      "WarpParse 部署",
      "source",
      "sink",
      "connector",
      "wproj",
      "wpgen",
      "wp-monitor",
      "文件到文件",
      "发送测试数据",
      "样本回放",
      "观测验证",
      "卸载",
      "清理",
      "file to file",
      "docker compose",
      "联调",
      "观测"
    ],
    "patterns": [
      "怎么部署.*WarpParse",
      "怎么生成.*配置",
      "帮我搭.*工程",
      "安装.*wparse.*文件.*文件",
      "安装.*wparse.*file.*file",
      "给.*文件.*文件.*示例",
      "给.*file.*file.*示例",
      "文件到文件.*示例",
      "帮我配.*source",
      "帮我配.*sink",
      "怎么接.*wpgen",
      "怎么接.*wp-monitor",
      "发送.*测试数据",
      "回放.*样本",
      "观测.*验证",
      "怎么.*看.*miss",
      "卸载.*wparse",
      "清理.*WarpParse",
      "删除.*wp-monitor",
      "如何.*联调",
      "怎么把.*链路跑起来"
    ]
  },
  "dependencies": {
    "optional": [
      {
        "name": "wparse",
        "description": "WarpParse 解析引擎",
        "url": "https://get.warpparse.ai"
      },
      {
        "name": "wproj",
        "description": "WarpParse 工程管理工具",
        "url": "https://get.warpparse.ai"
      },
      {
        "name": "wpgen",
        "description": "WarpParse 数据生成工具",
        "url": "https://get.warpparse.ai"
      },
      {
        "name": "wp-monitor",
        "description": "WarpParse 观测界面",
        "url": "https://get.warpparse.ai"
      },
      {
        "name": "wpl-check",
        "description": "WPL/OML 离线验证工具",
        "url": "https://github.com/wp-labs/wpl-check"
      }
    ]
  },
  "resources": {
    "docs": "https://docs.warpparse.ai",
    "github": "https://github.com/wp-labs"
  },
  "files": {
    "skill": "SKILL.md",
    "agents": {
      "openai": "agents/openai.yaml"
    },
    "references": [
      "references/cli-introduce.md",
      "references/connector-introduce.md",
      "references/wpgen.md",
      "references/wp-monitor.md",
      "references/warp-console-observability.md"
    ]
  }
}
