name : /oml/normal/vaultwarden_request
rule : vaultwarden/vaultwarden_request
---
access_ip: ip = read(wp_src_ip);
log_desc = read(log_desc);
log_type = read(log_type);
raw_msg = pipe take(raw_msg) | json_escape;

occur_time = pipe read(request_time) | Time::to_ts_zone(8, ms);
logger = read(logger);
level = read(level);
method = read(method);
path = read(path);
