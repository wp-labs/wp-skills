#[copy_raw(name:"raw_msg")]
package nginx {
  #[tag(log_desc:"Nginx access log", log_type:"nginx_access")]
  rule nginx_access {
    (
      ip:src_ip,
      2*_,
      time/clf:access_time<[,]>,
      http/request:request",
      http/status:status,
      digit:body_bytes_sent,
      chars:referer",
      chars:user_agent",
      chars:x_forwarded_for"
    )
  }
}
